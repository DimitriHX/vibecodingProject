# ──────────────────────────────────────────────────────────────
# FocusFlow — Variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# ──────────────────────────────────────────────────────────────

# Nombre público de la aplicación (visible en el cliente).
NEXT_PUBLIC_APP_NAME=FocusFlow

# URL base de la API pública de DEV.to (consumida solo en el servidor).
DEVTO_API_URL=https://dev.to/api

# Clave opcional de DEV.to. No es necesaria para leer artículos públicos,
# pero aumenta el límite de peticiones. Nunca la expongas con NEXT_PUBLIC_.
DEVTO_API_KEY=

# Número de artículos por petición (1-30).
DEVTO_ARTICLES_PER_PAGE=12

# Segundos que se cachean las respuestas de DEV.to en el servidor.
DEVTO_CACHE_SECONDS=600
